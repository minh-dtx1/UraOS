# Sao chép thành .env rồi điền khóa API của bạn (lấy tại https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...
# Tùy chọn
URA_MODEL=claude-opus-5-5
URA_EFFORT=medium        # low | medium | high | xhigh | max
URA_USER_NAME=Minh       # Ura sẽ gọi bạn bằng tên này
URA_WEB_SEARCH=1         # 1 = cho phép Ura tìm kiếm Internet
URA_PORT=8000
